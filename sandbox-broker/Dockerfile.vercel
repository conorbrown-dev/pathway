# Build context: sandbox-broker. Detected by name by Vercel's Container Runtime when the project's
# root directory is sandbox-broker; also used by the Fly.io fallback config. Learner code does not
# run in this image: the broker creates Vercel Sandbox microVMs from the images in images/.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src ./src
ENV PORT=8080 NODE_ENV=production
EXPOSE 8080
USER node
CMD ["node", "src/server.mjs"]
