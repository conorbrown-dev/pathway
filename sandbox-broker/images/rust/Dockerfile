# Vercel Sandbox image for Rust exercises.
FROM rust:1.97-slim
RUN mkdir -p /workspace && chmod 0777 /workspace

# Prebuilt crates for exercises that need them (Tokio, Axum, serde, ...). The sandbox has no
# network and the grading time limit is short, so these are compiled once, here. Graders compile a
# submission against them with /usr/local/bin/pathway-rustc, which runs rustc with the exact
# --extern and -L flags Cargo used for this project: no Cargo, no network, no writes outside
# /workspace at grading time.
COPY rust/crates /opt/pathway-crates
RUN set -eu \
 && cd /opt/pathway-crates \
 && cargo build \
 && touch src/main.rs \
 && cargo build -v 2>&1 | grep -F -- '--crate-name pathway_crates' > /tmp/rustc-line \
 && deps="$(grep -o -- '-L dependency=[^ `]*' /tmp/rustc-line | sort -u | tr '\n' ' ')" \
 && externs="$(grep -o -- '--extern [^ `]*' /tmp/rustc-line | tr '\n' ' ')" \
 && test -n "$deps" && test -n "$externs" \
 && printf '%s\n' \
      '#!/bin/sh' \
      '# Generated by the image build from the rustc command Cargo used for /opt/pathway-crates.' \
      '# Usage: pathway-rustc main.rs -o main' \
      "exec rustc --edition=2024 --crate-type bin -C debuginfo=0 $deps $externs \"\$@\"" \
      > /usr/local/bin/pathway-rustc \
 && chmod 0755 /usr/local/bin/pathway-rustc \
 && cargo tree --offline --depth 1 --prefix none | sort -u > /opt/pathway-crates/CRATES.txt \
 && rm -rf target/debug/incremental /usr/local/cargo/registry/src /usr/local/cargo/registry/cache /tmp/rustc-line \
 && chmod -R a+rX /opt/pathway-crates

# Learner code runs as this unprivileged user via /usr/local/bin/as-learner (see ../as-learner).
COPY --chmod=0755 as-learner /usr/local/bin/as-learner
RUN groupadd --gid 10001 learner \
 && useradd --uid 10001 --gid 10001 --create-home --shell /bin/sh learner \
 && command -v setpriv
WORKDIR /workspace
