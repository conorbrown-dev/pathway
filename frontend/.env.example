# Leave empty to call the API on the same origin (production: Vercel rewrites /api to the API project).
# For local development point it at the API: http://localhost:5100
VITE_API_BASE_URL=http://localhost:5100

# Auth0 single-page application. The audience is the identifier of the Auth0 API that represents
# the Pathway API; it must match AUTH_AUDIENCE on the API.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Public URL for Stripe Payment Links, Ko-fi, GitHub Sponsors, or another donation provider.
VITE_DONATION_URL=
