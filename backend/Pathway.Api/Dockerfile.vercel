# Build context: backend/Pathway.Api. Vercel's Container Runtime detects this file by name
# (Dockerfile.vercel) when the project's root directory is backend/Pathway.Api; the Fly.io
# fallback config (fly.toml) builds the same file.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Pathway.Api.csproj ./
RUN dotnet restore
COPY . ./
RUN dotnet publish --configuration Release --no-restore --output /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app ./
ENV ASPNETCORE_ENVIRONMENT=Production \
    PORT=8080
EXPOSE 8080
# The aspnet image ships a non-root "app" user; never run the API as root.
USER $APP_UID
# Listen on $PORT, which the hosting platform may override.
CMD ["sh", "-c", "exec dotnet Pathway.Api.dll --urls http://+:${PORT}"]
